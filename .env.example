# ── Cloudinary (Image & Video Storage) ──────────────────────────────────
# 1. Sign up for a free account at https://cloudinary.com
# 2. Go to your Cloudinary Dashboard / Console: https://console.cloudinary.com
# 3. Copy your Cloud Name, API Key, and API Secret below into a .env.local file.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional folder inside your Cloudinary Media Library (defaults to 'memoir')
CLOUDINARY_FOLDER=memoir

# ── Optional shared passcode ─────────────────────────────────────────────
# Leave blank to skip the "Enter our memories" screen entirely.
# Set it to something memorable for the two of you.
# You can use ACCESS_CODE (server-only, recommended for Vercel) or NEXT_PUBLIC_ACCESS_CODE.
ACCESS_CODE=
NEXT_PUBLIC_ACCESS_CODE=

# ── Discord Integration (Optional) ───────────────────────────────────────
# Option A: Standalone Discord Bot
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Option B: Discord Webhook
DISCORD_WEBHOOK_URL=

# ── Upstash Redis (90-day Device & IP Session Memory) ────────────────────
# 1. Create a free database at https://upstash.com
# 2. Copy the REST URL and REST Token below:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

